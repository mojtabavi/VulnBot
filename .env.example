# Copy to .env and fill secrets:  cp .env.example .env
# .env is git-ignored; never commit real secrets.

# ── Octopus core ──────────────────────────────────────────────────────────────
# PENTEST_ROOT is where config YAMLs + logs + data live (defaults to repo root ".").
PENTEST_ROOT=.

# Optional HTTP proxies honored by server/utils/utils.py
# http_proxy=
# https_proxy=
# no_proxy=127.0.0.1,localhost

# ── MySQL (sessions/plans/tasks/conversations/messages) ───────────────────────
# Used by the `mysql` compose service (profile: data) when MySQL mode = docker.
# db_config.yaml must match these (host 127.0.0.1, port 3306, same user/pass/db).
MYSQL_DATABASE=octopus
MYSQL_USER=octopus
MYSQL_PASSWORD=octopus
MYSQL_ROOT_PASSWORD=octopus

# ── Metasploit RPC (agent -> kali) ────────────────────────────────────────────
MSF_RPC_PASSWORD=change_me_strong

# ── Kali SSH access (agent -> kali) ───────────────────────────────────────────
# Paste the agent's SSH PUBLIC key here so the kali container authorizes it.
# Generate with:  make -n  (see docker/agent/keys) or:
#   ssh-keygen -t ed25519 -N "" -f docker/agent/keys/agent_ed25519
# then paste the contents of docker/agent/keys/agent_ed25519.pub below.
AGENT_SSH_PUBKEY=

# ── LLM backend ───────────────────────────────────────────────────────────────
# local -> run a quantized model on the RTX 5080 via the `ollama` service
#          (compose profile: local; agent has NO egress). Leave API keys blank.
# api   -> use a hosted API (compose profile: api; agent joins the egress network).
#          Set the matching key below.
LLM_BACKEND=local
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Claude Pro/Max subscription bearer (auth_mode: oauth). Obtained via the CLI `/login`
# flow (subtask B6). Keep BLANK unless using a subscription; git-ignored at rest.
ANTHROPIC_AUTH_TOKEN=
