      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Active only when enable_rag AND a kb_name is passed to _chat; else rag/ (and\nits heavy langchain imports) is never touched. The /kb/* FastAPI routes\n(rag/kb/api) build the knowledge bases. Because _chat is the single choke\npoint, RAG augmentation is transparent to every caller.",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "el1852",
      "originalText": "Active only when enable_rag AND a kb_name is passed to _chat; else rag/ (and\nits heavy langchain imports) is never touched. The /kb/* FastAPI routes\n(rag/kb/api) build the knowledge bases. Because _chat is the single choke\npoint, RAG augmentation is transparent to every caller.",
      "lineHeight": 1.25,
      "baseline": 15
    }
