      "versionNonce": 7720,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Why soft:\nZ floored at EPS=1e-3, so\nposterior never collapses to 0.\nOnly the ORDER of likelihoods\nmust be right (e.g. a failed\nexploit is more expected if the\nvuln is ABSENT).",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "el0955",
      "originalText": "Why soft:\nZ floored at EPS=1e-3, so\nposterior never collapses to 0.\nOnly the ORDER of likelihoods\nmust be right (e.g. a failed\nexploit is more expected if the\nvuln is ABSENT).",
      "lineHeight": 1.25,
      "baseline": 15
    }
  ],
