# Knowledge Base Configuration (kb_config.yaml)
# Only relevant when enable_rag: true (Milvus vector store).
default_vs_type: milvus
milvus:
  uri: "http://127.0.0.1:19530"
  user: ""
  password: ""
kb_name: "pentest_kb"

chunk_size: 750
overlap_size: 150
top_n: 1
top_k: 3
score_threshold: 0.5
search_params:
  metric_type: L2
  params:
    nprobe: 10
index_params:
  metric_type: L2
  index_type: HNSW
  params:
    M: 16
    efConstruction: 200
text_splitter_name: RecursiveCharacterTextSplitter
